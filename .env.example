# Copy to .env.local and fill in at least one paid brain key (Claude or OpenAI).
# The Gemini free tier alone (~20 req/day) is not enough for real use.

GEMINI_API_KEY=

# Anthropic Claude — recommended primary brain
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI GPT — brain + vision fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Perplexity — live web research (research_web tool)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Local Ollama (offline fallback, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Provider order overrides
# AI_PROVIDER_ORDER=claude,openai,gemini,ollama
# VISION_PROVIDER_ORDER=gemini,openai,claude
